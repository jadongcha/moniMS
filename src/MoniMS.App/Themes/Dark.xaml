<!-- 다크 테마 색상 토큰. 키 목록은 Light.xaml과 반드시 같아야 한다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#14161B" />
    <SolidColorBrush x:Key="CardBrush" Color="#1C1F26" />
    <SolidColorBrush x:Key="InputBrush" Color="#15181D" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#2C313B" />
    <SolidColorBrush x:Key="StrongStrokeBrush" Color="#3D4450" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E8EC" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9AA3B2" />
    <SolidColorBrush x:Key="HoverBrush" Color="#262A33" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#1E2B45" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#3D4450" />
</ResourceDictionary>
