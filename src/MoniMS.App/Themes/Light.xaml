<!-- 라이트 테마 색상 토큰. 키 목록은 Dark.xaml과 반드시 같아야 한다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#E3E6EB" />
    <SolidColorBrush x:Key="StrongStrokeBrush" Color="#C5CBD3" />
    <SolidColorBrush x:Key="TextBrush" Color="#111827" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F0F2F5" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#E8EFFD" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#C5CBD3" />
</ResourceDictionary>
