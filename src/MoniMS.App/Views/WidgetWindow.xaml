<Window x:Class="MoniMS.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MoniMS.App.ViewModels"
        xmlns:c="clr-namespace:MoniMS.App.Controls"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="MoniMS Widget"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Topmost="False"
        Width="{Binding WindowWidth}" Height="{Binding WindowHeight}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 아래 브러시는 코드에서 스타일(Dark/Light/Glass)에 맞게 교체된다 -->
        <SolidColorBrush x:Key="WidgetBackground" Color="#E6141820" />
        <SolidColorBrush x:Key="WidgetBorder" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="WidgetForeground" Color="#F1F5F9" />
        <SolidColorBrush x:Key="WidgetSubtle" Color="#94A3B8" />
        <SolidColorBrush x:Key="WidgetTrack" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="WidgetAccent" Color="#60A5FA" />
        <SolidColorBrush x:Key="WidgetAccentFill" Color="#3360A5FA" />

        <!-- 글자 테두리: 배경이 비칠 때만 두께가 생긴다 (WidgetWindow.ApplyStyle에서 설정) -->
        <SolidColorBrush x:Key="WidgetOutline" Color="#CC000000" />
        <sys:Double x:Key="WidgetOutlineThickness">0</sys:Double>
        <Style TargetType="c:OutlinedText">
            <Setter Property="Stroke" Value="{DynamicResource WidgetOutline}" />
            <Setter Property="StrokeThickness" Value="{DynamicResource WidgetOutlineThickness}" />
        </Style>

        <Style x:Key="Caption" TargetType="c:OutlinedText" BasedOn="{StaticResource {x:Type c:OutlinedText}}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource WidgetSubtle}" />
        </Style>
        <Style x:Key="Detail" TargetType="c:OutlinedText" BasedOn="{StaticResource {x:Type c:OutlinedText}}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource WidgetSubtle}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Value" TargetType="c:OutlinedText" BasedOn="{StaticResource {x:Type c:OutlinedText}}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 시스템 정보 -->
        <DataTemplate DataType="{x:Type vm:SystemSectionViewModel}">
            <StackPanel Margin="0,0,0,10">
                <c:OutlinedText Text="{Binding ComputerName}" FontSize="18" FontWeight="SemiBold" />
                <c:OutlinedText Text="{Binding Os}" Style="{StaticResource Detail}" Margin="0,1,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <c:OutlinedText Grid.Row="0" Text="BUILD" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <c:OutlinedText Grid.Row="0" Grid.Column="1" Text="{Binding OsBuild}" Style="{StaticResource Value}" />
                    <c:OutlinedText Grid.Row="1" Text="CPU" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <c:OutlinedText Grid.Row="1" Grid.Column="1" Text="{Binding Cpu}" Style="{StaticResource Value}" ToolTip="{Binding Cpu}" />
                    <c:OutlinedText Grid.Row="2" Text="GPU" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <c:OutlinedText Grid.Row="2" Grid.Column="1" Text="{Binding Gpu}" Style="{StaticResource Value}" />
                    <c:OutlinedText Grid.Row="3" Text="RAM" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <c:OutlinedText Grid.Row="3" Grid.Column="1" Text="{Binding Ram}" Style="{StaticResource Value}" />
                    <c:OutlinedText Grid.Row="4" Text="BOARD" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <c:OutlinedText Grid.Row="4" Grid.Column="1" Text="{Binding Board}" Style="{StaticResource Value}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- CPU / 메모리 / GPU 게이지 -->
        <DataTemplate DataType="{x:Type vm:GaugeSectionViewModel}">
            <Grid Margin="0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <c:OutlinedText DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="16" FontWeight="SemiBold" />
                    <c:OutlinedText Text="{Binding Title}" Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="12" />
                </DockPanel>
                <Border Grid.Row="1" Margin="0,3" BorderBrush="{DynamicResource WidgetTrack}" BorderThickness="0,0,0,1">
                    <Viewbox Stretch="Fill">
                        <Canvas Width="59" Height="100" ClipToBounds="True">
                            <Polygon Points="{Binding AreaPoints}" Fill="{DynamicResource WidgetAccentFill}" />
                            <Polyline Points="{Binding LinePoints}" Stroke="{DynamicResource WidgetAccent}"
                                      StrokeThickness="0.9" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <c:OutlinedText Grid.Row="2" Text="{Binding Detail}" Style="{StaticResource Detail}" />
            </Grid>
        </DataTemplate>

        <!-- 디스크 -->
        <DataTemplate DataType="{x:Type vm:DiskSectionViewModel}">
            <StackPanel Margin="0,6">
                <c:OutlinedText Text="DRIVE" Style="{StaticResource Caption}" FontSize="12" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DiskItemViewModel}">
                            <StackPanel Margin="0,2,0,5">
                                <DockPanel>
                                    <c:OutlinedText DockPanel.Dock="Right" Text="{Binding Text}" Style="{StaticResource Detail}" />
                                    <c:OutlinedText Text="{Binding Name}" Style="{StaticResource Value}" />
                                </DockPanel>
                                <Border Height="5" CornerRadius="2.5" Background="{DynamicResource WidgetTrack}" Margin="0,3,0,0">
                                    <Border CornerRadius="2.5" Background="{DynamicResource WidgetAccent}"
                                            HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Fraction}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- 네트워크 -->
        <DataTemplate DataType="{x:Type vm:NetworkSectionViewModel}">
            <StackPanel Margin="0,6">
                <DockPanel>
                    <c:OutlinedText DockPanel.Dock="Right" Text="{Binding Ip}" FontSize="14" FontWeight="SemiBold" />
                    <c:OutlinedText Text="NETWORK" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
                <c:OutlinedText Text="{Binding Adapter}" Style="{StaticResource Detail}" Margin="0,2,0,4" />
                <UniformGrid Columns="2">
                    <StackPanel Orientation="Horizontal">
                        <c:OutlinedText Text="↓ " Style="{StaticResource Value}" Foreground="{DynamicResource WidgetAccent}" FontWeight="Bold" />
                        <c:OutlinedText Text="{Binding Download}" Style="{StaticResource Value}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <c:OutlinedText Text="↑ " Style="{StaticResource Value}" Foreground="{DynamicResource WidgetAccent}" FontWeight="Bold" />
                        <c:OutlinedText Text="{Binding Upload}" Style="{StaticResource Value}" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </DataTemplate>

        <!-- 가동 시간 -->
        <DataTemplate DataType="{x:Type vm:UptimeSectionViewModel}">
            <DockPanel Margin="0,8,0,0">
                <c:OutlinedText DockPanel.Dock="Right" Text="{Binding Clock}" Style="{StaticResource Detail}" />
                <StackPanel Orientation="Horizontal">
                    <c:OutlinedText Text="Uptime " Style="{StaticResource Detail}" />
                    <c:OutlinedText Text="{Binding Uptime}" Style="{StaticResource Detail}" Foreground="{DynamicResource WidgetForeground}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Margin="8">
        <Border x:Name="Card" CornerRadius="14" Padding="18,16" ClipToBounds="True"
                Background="{DynamicResource WidgetBackground}"
                BorderBrush="{DynamicResource WidgetBorder}" BorderThickness="1"
                TextElement.Foreground="{DynamicResource WidgetForeground}">
            <Border.LayoutTransform>
                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
            </Border.LayoutTransform>
            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" />
        </Border>

        <!-- 편집 모드 표시: 점선 테두리 + 안내 -->
        <Border CornerRadius="14" BorderThickness="2" IsHitTestVisible="False"
                BorderBrush="{DynamicResource WidgetAccent}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-12,0,0"
                    Background="{DynamicResource WidgetAccent}" CornerRadius="8" Padding="10,3">
                <TextBlock Text="Drag to move · finish from the tray menu" FontSize="11" Foreground="White" />
            </Border>
        </Border>
    </Grid>
</Window>
