<Window x:Class="MoniMS.App.Views.ImageWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoniMS Image Widget"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Topmost="False"
        Width="320" Height="320" MinWidth="48" MinHeight="48" UseLayoutRounding="True">

    <!-- 편집 모드에서는 투명한 부분도 잡을 수 있도록 Root에 옅은 배경을 깐다 (투명 픽셀은 마우스가 통과하므로) -->
    <Grid x:Name="Root">
        <!-- 사진: ImageBrush가 창 크기에 맞춰 늘어나고 줄어든다. 테두리 둥글기는 Border가 잘라 준다. -->
        <Border x:Name="Picture" RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- 편집 모드 표시: 테두리 + 안내 + 오른쪽 아래 크기 조절 표시 -->
        <Grid x:Name="EditOverlay" Visibility="Collapsed" IsHitTestVisible="False">
            <Border x:Name="EditFrame" BorderThickness="2" BorderBrush="#60A5FA" />
            <Border x:Name="EditLabel" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="8,8,8,0"
                    Background="#60A5FA" CornerRadius="8" Padding="8,2">
                <TextBlock Text="Drag to move · drag edges to resize" FontSize="11" Foreground="White"
                           TextTrimming="CharacterEllipsis" />
            </Border>
            <Path x:Name="EditGrip" Data="M 14,0 L 14,14 L 0,14 Z" Fill="#60A5FA"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" />
        </Grid>
    </Grid>
</Window>
