<Window x:Class="MoniMS.App.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MoniMS.App.ViewModels"
        Title="MoniMS Settings" Width="820" Height="600" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}"
        Icon="/Assets/moniMS.ico">

    <Window.Resources>
        <!-- 색 고르기 (정보 위젯 그래프 색, 음악 위젯 버튼 색): 드롭다운처럼 생긴 버튼을 누르면 색 표가 펼쳐진다 + Windows 강조색 따라가기 -->
        <DataTemplate DataType="{x:Type vm:ColorPickerViewModel}">
            <StackPanel>
                <Grid Width="240" Height="32" HorizontalAlignment="Left">
                    <!-- 표가 열린 동안에는 버튼이 클릭을 받지 않는다 (받으면 닫혔다가 바로 다시 열림) -->
                    <ToggleButton x:Name="ColorButton" Style="{StaticResource ComboToggle}" Focusable="True"
                                  IsChecked="{Binding IsOpen}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=ColorPopup, Converter={StaticResource InverseBool}}"
                                  AutomationProperties.Name="{Binding ChooseText}" ToolTip="Choose a color" />
                    <StackPanel Orientation="Horizontal" Margin="6,0,28,0" IsHitTestVisible="False">
                        <Border Width="20" Height="20" CornerRadius="4" Background="{Binding PreviewBrush}"
                                BorderBrush="{DynamicResource StrongStrokeBrush}" BorderThickness="1" />
                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180" />
                    </StackPanel>
                </Grid>
                <CheckBox Content="Use Windows accent color" IsChecked="{Binding UseWindowsAccent}" Margin="0,6,0,0"
                          ToolTip="Follow the Windows accent color (Settings → Personalization → Colors)" />
                <Popup x:Name="ColorPopup" IsOpen="{Binding IsOpen}" PlacementTarget="{Binding ElementName=ColorButton}"
                       Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8">
                        <ListBox ItemsSource="{Binding ColorSwatches}" SelectedItem="{Binding SelectedSwatch}"
                                 HorizontalAlignment="Left" BorderThickness="0" Background="Transparent" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="{Binding Name}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding ColorColumns}" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="1" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="ToolTip" Value="{Binding Hex}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Hex}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <!-- 칸 하나: 고른 칸은 테두리 링, 마우스를 올리면 옅은 링 -->
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Ring" Width="23" Height="23" CornerRadius="5" Padding="2"
                                                        BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                                                    <Border CornerRadius="3" Background="{Binding Brush}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource StrongStrokeBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Popup>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="24,20,24,16">
        <!-- 헤더 -->
        <DockPanel DockPanel.Dock="Top">
            <!-- 라이트/다크 전환 스위치 -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        ToolTip="Light / Dark mode">
                <TextBlock Text="Light" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsDarkMode}" />
                <TextBlock Text="Dark" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Hint}"
                       VerticalAlignment="Center" MaxWidth="320" TextAlignment="Right" Margin="0,0,20,0" />
            <TextBlock Text="MoniMS" Style="{StaticResource Title}" />
        </DockPanel>

        <TabControl>
            <!-- ===== 프리셋 ===== -->
            <TabItem Header="Presets">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- 왼쪽: 프리셋 목록 카드 + 그 아래 동작 버튼(2줄) -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="8">
                        <DockPanel>
                            <!-- 선택 해제 → 오른쪽에 저장 폼 -->
                            <Button DockPanel.Dock="Top" Content="＋ Save current desktop" HorizontalAlignment="Left"
                                    Margin="8,4,8,6" Command="{Binding NewPresetCommand}" />
                            <Grid>
                                <!-- 가로 스크롤을 끄면 항목 폭이 목록 폭에 맞춰져서 오른쪽 날짜가 잘리지 않는다 -->
                                <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         MouseDoubleClick="OnPresetDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PresetItemViewModel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,1"
                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="ACTIVE" Foreground="White" FontSize="10.5" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PartsText}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <!-- 날짜: 박스 안쪽 오른쪽 위, 줄바꿈 없이 항상 다 보이게 -->
                                                <TextBlock Grid.Column="1" Text="{Binding UpdatedText}" Foreground="{DynamicResource SubtleTextBrush}"
                                                           FontSize="11" TextWrapping="NoWrap" VerticalAlignment="Top"
                                                           Margin="12,2,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="No presets yet.&#x0a;Save your current desktop on the right."
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Presets.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- 동작 버튼: 2 x 2, 모두 같은 크기 -->
                    <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,10,0,0">
                        <UniformGrid.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Height" Value="34" />
                                <Setter Property="Padding" Value="10,0" />
                            </Style>
                        </UniformGrid.Resources>
                        <Button Content="Apply" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Height="34" Margin="0,0,4,4" />
                        <Button Content="Overwrite" Command="{Binding OverwriteCommand}" Margin="4,0,0,4"
                                ToolTip="Overwrite the selected preset with the current desktop" />
                        <Button Content="Rename" Command="{Binding RenameCommand}" Margin="0,4,4,0" />
                        <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Height="34" Margin="4,4,0,0" />
                    </UniformGrid>
                    </Grid>


                    <!-- 프리셋을 선택하면 미리보기 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}"
                            Visibility="{Binding Preview, Converter={StaticResource NullToVisible}, ConverterParameter=invert}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,10,0" DataContext="{Binding Preview}">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />

                                <!-- 축소 바탕화면: 배경화면 + 아이콘 위치 + 위젯 위치 -->
                                <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}" ClipToBounds="True">
                                    <Viewbox Stretch="Uniform">
                                        <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" ClipToBounds="True"
                                              Background="{Binding DesktopBackground}">
                                            <Image Source="{Binding WallpaperImage}" Stretch="{Binding WallpaperStretch}" />
                                            <ItemsControl ItemsSource="{Binding Icons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:PreviewIcon}">
                                                        <Border Width="56" Height="56" Margin="18,6" CornerRadius="10"
                                                                Background="#B3FFFFFF" BorderBrush="#66000000" BorderThickness="2"
                                                                ToolTip="{Binding Name}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Canvas Visibility="{Binding HasWidget, Converter={StaticResource BoolToVisibility}}">
                                                <Border Canvas.Left="{Binding WidgetLeft}" Canvas.Top="{Binding WidgetTop}"
                                                        Width="{Binding WidgetWidth}" Height="{Binding WidgetHeight}"
                                                        CornerRadius="20" Background="{Binding WidgetBrush}"
                                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="6">
                                                    <TextBlock Text="WIDGET" Foreground="White" FontSize="56" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Canvas>
                                            <!-- 사진 위젯: 저장된 위치·크기에 실제 사진 -->
                                            <Canvas Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                                                <Border Canvas.Left="{Binding ImageLeft}" Canvas.Top="{Binding ImageTop}"
                                                        Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                                                        CornerRadius="{Binding ImageCornerRadius}" Opacity="{Binding ImageOpacity}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding ImagePicture}" Stretch="Fill" />
                                                    </Border.Background>
                                                </Border>
                                            </Canvas>
                                            <!-- 파일 위젯: 저장된 위치·크기 -->
                                            <Canvas Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}">
                                                <Border Canvas.Left="{Binding FilesLeft}" Canvas.Top="{Binding FilesTop}"
                                                        Width="{Binding FilesWidth}" Height="{Binding FilesHeight}"
                                                        CornerRadius="16" Background="{Binding FilesBrush}"
                                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="6">
                                                    <TextBlock Text="FILES" Foreground="White" FontSize="56" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Canvas>
                                            <!-- 음악 위젯: 저장된 위치·크기 -->
                                            <Canvas Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
                                                <Border Canvas.Left="{Binding MediaLeft}" Canvas.Top="{Binding MediaTop}"
                                                        Width="{Binding MediaWidth}" Height="{Binding MediaHeight}"
                                                        CornerRadius="16" Background="{Binding MediaBrush}"
                                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="6">
                                                    <TextBlock Text="MEDIA" Foreground="White" FontSize="56" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Canvas>
                                            <!-- 작업표시줄 자리 -->
                                            <Border Height="48" VerticalAlignment="Bottom" Background="#99101216" />
                                        </Grid>
                                    </Viewbox>
                                </Border>

                                <!-- 강조색 -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                                    <TextBlock Text="Accent" Style="{StaticResource Hint}" Width="72" VerticalAlignment="Center" />
                                    <Border Width="16" Height="16" CornerRadius="4" Margin="0,0,8,0" Background="{Binding AccentSwatch}"
                                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                            Visibility="{Binding AccentSwatch, Converter={StaticResource NullToVisible}, ConverterParameter=invert}" />
                                    <TextBlock Text="{Binding AccentText}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- 저장된 항목 요약 -->
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PreviewRow}">
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Hint}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="Double-click or press Apply to load. Icons show saved positions only; deleted files are not recreated." />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 선택이 없으면 현재 바탕화면 저장 폼 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}"
                            Visibility="{Binding Preview, Converter={StaticResource NullToVisible}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Save current desktop" Style="{StaticResource SectionTitle}" />
                            <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                                     ToolTip="Leave empty to name it by date" />
                            <TextBlock Text="Include" Style="{StaticResource Hint}" Margin="0,0,0,2" />
                            <CheckBox Content="Wallpaper (per monitor)" IsChecked="{Binding IncludeWallpaper}" />
                            <CheckBox Content="Theme (dark/light · accent color)" IsChecked="{Binding IncludeTheme}" />
                            <CheckBox Content="Desktop icon layout" IsChecked="{Binding IncludeIcons}" />
                            <CheckBox Content="Info widget layout" IsChecked="{Binding IncludeWidget}" />
                            <CheckBox Content="Image widget (picture · position · size)" IsChecked="{Binding IncludeImageWidget}" />
                            <CheckBox Content="File widget (folders · position · size)" IsChecked="{Binding IncludeFileWidget}" />
                            <CheckBox Content="Media widget (position · size · style)" IsChecked="{Binding IncludeMediaWidget}" />
                            <Button Content="Save as new preset" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveNewCommand}" Margin="0,12,0,0" HorizontalAlignment="Stretch" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="Overwrite keeps the items a preset already has (older presets get the newer widgets added). For icon layouts, turn off desktop right-click → View → 'Auto arrange icons'." />

                            <!-- 아이콘 배치의 한계 안내: 위치만 저장되고 파일은 저장되지 않음 -->
                            <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{DynamicResource DangerBrush}" Background="{DynamicResource HoverBrush}">
                                <StackPanel>
                                    <TextBlock Text="⚠ Icon layout saves positions only" FontWeight="Bold"
                                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Text="Files, apps or shortcuts you delete from the desktop are NOT recreated when you load a preset. Their spot just stays empty." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== 위젯 ===== -->
            <TabItem Header="Info widget">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Display" Style="{StaticResource SectionTitle}" />
                            <CheckBox Content="Show widget" IsChecked="{Binding WidgetVisible}" />
                            <CheckBox Content="Edit position (drag to move)" IsChecked="{Binding EditMode}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="The widget is always click-through, so icons behind it stay clickable. Turn on Edit position to drag it." />

                            <TextBlock Text="Style" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                            <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding Style}" Width="160" HorizontalAlignment="Left" />

                            <TextBlock Margin="0,12,0,2" Style="{StaticResource Hint}" Text="Font" />
                            <ComboBox ItemsSource="{Binding FontChoices}" SelectedItem="{Binding Font}" Width="260"
                                      HorizontalAlignment="Left" IsTextSearchEnabled="True" MaxDropDownHeight="320" />

                            <TextBlock Margin="0,12,0,2" Style="{StaticResource Hint}">
                                <Run Text="Background opacity" /> <Run Text="{Binding WidgetOpacity, StringFormat=P0, Mode=OneWay}" />
                            </TextBlock>
                            <Slider Minimum="0" Maximum="1" Value="{Binding WidgetOpacity}" SmallChange="0.05" LargeChange="0.1" />

                            <!-- 너비/높이/배율 슬라이더는 제거됨 (값은 설정·프리셋에 저장된 그대로 사용) -->

                            <TextBlock Margin="0,14,0,2" Style="{StaticResource Hint}" Text="Graph color" />
                            <ContentControl Content="{Binding GraphColor}" Focusable="False" HorizontalAlignment="Left" />
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Sections and order" Style="{StaticResource SectionTitle}" />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="▲ Up" Command="{Binding MoveSectionUpCommand}" />
                                <Button Content="▼ Down" Command="{Binding MoveSectionDownCommand}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SectionToggleViewModel}">
                                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsEnabled}" Margin="0" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== 사진 위젯 ===== -->
            <TabItem Header="Image widget">
                <Grid DataContext="{Binding Image}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 왼쪽: 사진 고르기 + 미리보기 -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Picture" Style="{StaticResource SectionTitle}" />
                            <StackPanel DockPanel.Dock="Bottom">
                                <TextBlock Text="{Binding ImageName}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"
                                           ToolTip="{Binding ImageName}" />
                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding Error, Converter={StaticResource NullToVisible}, ConverterParameter=invert}" />
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <Button Content="Choose image…" Style="{StaticResource PrimaryButton}" Command="{Binding ChooseImageCommand}"
                                            Margin="0,0,4,0" Padding="6,6" />
                                    <Button Content="Remove" Command="{Binding RemoveImageCommand}" Margin="4,0,0,0" Padding="6,6"
                                            IsEnabled="{Binding HasImage}" />
                                </UniformGrid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="PNG, JPG, GIF (animated), BMP, WebP. MoniMS keeps its own copy, so you can move or delete the original." />
                            </StackPanel>
                            <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}"
                                    Background="{DynamicResource HoverBrush}" MinHeight="160">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="8"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="No picture yet.&#x0a;Choose a picture or GIF to show it on your desktop."
                                               Style="{StaticResource Hint}" TextAlignment="Center" TextWrapping="Wrap" Margin="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- 오른쪽: 표시 / 크기 / 모양 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,10,0" IsEnabled="{Binding HasImage}">
                                <TextBlock Text="Display" Style="{StaticResource SectionTitle}" />
                                <CheckBox Content="Show image widget" IsChecked="{Binding IsShown}" />
                                <CheckBox Content="Move &amp; resize" IsChecked="{Binding EditMode}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Like the info widget, it is click-through. Turn on Move &amp; resize to drag it around or drag an edge to resize. The picture keeps its shape." />

                                <TextBlock Margin="0,16,0,2" Style="{StaticResource Hint}">
                                    <Run Text="Size" /> <Run Text="{Binding SizeText, Mode=OneWay}" />
                                </TextBlock>
                                <Slider Minimum="48" Maximum="{Binding MaxWidth}" Value="{Binding ImageWidth}" SmallChange="8" LargeChange="64" />

                                <TextBlock Margin="0,12,0,2" Style="{StaticResource Hint}">
                                    <Run Text="Opacity" /> <Run Text="{Binding ImageOpacity, StringFormat=P0, Mode=OneWay}" />
                                </TextBlock>
                                <Slider Minimum="0.1" Maximum="1" Value="{Binding ImageOpacity}" SmallChange="0.05" LargeChange="0.1" />

                                <TextBlock Margin="0,12,0,2" Style="{StaticResource Hint}">
                                    <Run Text="Rounded corners" /> <Run Text="{Binding CornerRadius, StringFormat={}{0:0}, Mode=OneWay}" />
                                </TextBlock>
                                <Slider Minimum="0" Maximum="48" Value="{Binding CornerRadius}" SmallChange="1" LargeChange="4" />

                                <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                                           Text="Presets save the image widget too (picture, position, size). Animated GIFs pause while a window covers them or the PC is locked, so they use no CPU then." />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== 파일 위젯 ===== -->
            <TabItem Header="File widget">
                <Grid DataContext="{Binding Files}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 왼쪽: 위젯에 보여 줄 폴더 -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Folders" Style="{StaticResource SectionTitle}" />
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="These folders are listed on the left of the file widget. Click one there to see what's inside." />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Add folder…" Style="{StaticResource PrimaryButton}" Command="{Binding AddFolderCommand}" />
                                <Button Content="Remove" Command="{Binding RemoveFolderCommand}" />
                                <Button Content="▲" Command="{Binding MoveFolderUpCommand}" ToolTip="Move up" Padding="10,6" />
                                <Button Content="▼" Command="{Binding MoveFolderDownCommand}" ToolTip="Move down" Padding="10,6" />
                            </StackPanel>
                            <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}">
                                <Grid>
                                    <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="File widget folders">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource CleanListItem}">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SidebarFolderViewModel}">
                                                <DockPanel ToolTip="{Binding ToolTip}">
                                                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0"
                                                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Hint}" TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="No folders yet.&#x0a;Add the folders you want to see on your desktop."
                                               Style="{StaticResource Hint}" TextAlignment="Center" Margin="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasFolders, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- 오른쪽: 표시 / 모양 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,10,0" IsEnabled="{Binding HasFolders}">
                                <TextBlock Text="Display" Style="{StaticResource SectionTitle}" />
                                <CheckBox Content="Show file widget" IsChecked="{Binding IsShown}" />
                                <CheckBox Content="Move &amp; resize" IsChecked="{Binding EditMode}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Unlike the other widgets, you can use the file widget with your mouse and keyboard: double-click to open, drag files in and out, right-click for more. Turn on Move &amp; resize to drag it around or drag an edge to resize it." />

                                <TextBlock Text="Style" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                                <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding Style}" Width="160" HorizontalAlignment="Left" />

                                <TextBlock Margin="0,12,0,2" Style="{StaticResource Hint}">
                                    <Run Text="Background opacity" /> <Run Text="{Binding WidgetOpacity, StringFormat=P0, Mode=OneWay}" />
                                </TextBlock>
                                <Slider Minimum="0" Maximum="1" Value="{Binding WidgetOpacity}" SmallChange="0.05" LargeChange="0.1" />

                                <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                                           Text="Presets save the file widget too (folders, position, size). Hidden files show only when File Explorer is set to show hidden items." />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== 음악 위젯 ===== -->
            <TabItem Header="Media widget">
                <Grid DataContext="{Binding Media}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 왼쪽: 표시 / 음량 / 찾은 플레이어 -->
                    <Border Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Display" Style="{StaticResource SectionTitle}" />
                                <CheckBox Content="Show media widget" IsChecked="{Binding IsShown}" />
                                <CheckBox Content="Move &amp; resize" IsChecked="{Binding EditMode}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Shows what's playing and lets you play or pause, skip and change the volume. Scroll over the widget to change the volume. Turn on Move &amp; resize to drag it around or drag an edge to resize it." />

                                <TextBlock Text="Volume slider changes" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                                <ComboBox ItemsSource="{Binding VolumeTargets}" SelectedIndex="{Binding VolumeTargetIndex}"
                                          HorizontalAlignment="Left" MinWidth="220" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="App volume is the app's own level in the Windows volume mixer, so other sounds stay as they are. For YouTube in a browser, it changes the whole browser." />

                                <TextBlock Text="Players found" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                                <TextBlock Text="{Binding PlayersText}" TextWrapping="Wrap" FontWeight="Normal" FontSize="12.5"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="Works with Spotify, YouTube and YouTube Music in your browser, the YouTube Music app and other players that show up in the Windows volume flyout. If more than one is open, click the app name on the widget to switch." />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 오른쪽: 모양 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Style" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding Style}" Width="160" HorizontalAlignment="Left" />

                            <TextBlock Margin="0,12,0,2" Style="{StaticResource Hint}">
                                <Run Text="Background opacity" /> <Run Text="{Binding WidgetOpacity, StringFormat=P0, Mode=OneWay}" />
                            </TextBlock>
                            <Slider Minimum="0" Maximum="1" Value="{Binding WidgetOpacity}" SmallChange="0.05" LargeChange="0.1" />

                            <TextBlock Margin="0,14,0,2" Style="{StaticResource Hint}" Text="Button &amp; bar color (play button, time bar, volume)" />
                            <ContentControl Content="{Binding ButtonColor}" Focusable="False" HorizontalAlignment="Left" />

                            <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                                       Text="Presets save the media widget too (shown or hidden, position, size, style, color)." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== 일반 ===== -->
            <TabItem Header="General">
                <Border Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                        <TextBlock Text="Data folder (presets · settings · logs)" Style="{StaticResource Hint}" Margin="0,16,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open folder" Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" />
                        </DockPanel>
                        <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
                        <TextBlock Margin="0,0,0,4">
                            <Run Text="Version" Foreground="{DynamicResource SubtleTextBrush}" /> <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}" Height="34" />
                            <Button Content="Update &amp; restart" Style="{StaticResource PrimaryButton}" Command="{Binding InstallUpdateCommand}"
                                    Height="34" Margin="8,0,0,0"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
